/* styles.tcss - structural only; colors come from the active Textual theme */

Screen {
    background: $background;
    color: $text;
}

#app-title {
    background: $background;
    color: $primary;
    text-align: center;
    text-style: bold;
    height: 1;
    margin-bottom: 0;
}

#main-container {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 2fr;
    grid-gutter: 1;
    padding: 1;
}

.pane {
    background: $surface;
    border: round $secondary;
    padding: 1;
    height: 100%;
}

DataTable {
    background: $surface;
    color: $text;
    height: 100%;
    border: none;
}

DataTable > .datatable--header {
    background: $surface;
    color: $secondary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary 20%;
}

Log {
    background: $surface;
    color: $text;
    border: none;
    height: 1fr;
}

#progress-area {
    height: 1;
    content-align: center middle;
    margin-top: 1;
}
