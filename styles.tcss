/* styles.tcss */

/* Catppuccin Mocha Palette */
$background: #1e1e2e;
$surface: #313244;
$primary: #cba6f7;   /* Mauve */
$secondary: #89b4fa; /* Blue */
$accent: #a6e3a1;    /* Green */
$error: #f38ba8;     /* Red */
$text: #cdd6f4;

Screen {
    background: $background;
    color: $text;
    scrollbar-size: 0 0; /* Hides all scrollbars */
}

#app-title {
    background: $background;
    color: $primary;
    text-align: center;
    text-style: bold;
    height: 1;
    margin-bottom: 0;
}

#main-container {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 2fr;
    grid-gutter: 1;
    padding: 1;
}

.pane {
    background: $surface;
    border: round $secondary;
    padding: 1;
    height: 100%;
    scrollbar-size: 0 0; /* Ensures panes don't show scrollbars */
}

DataTable {
    background: $surface;
    color: $text;
    height: 100%;
    border: none;
    scrollbar-size: 0 0;
}

DataTable > .datatable--header {
    background: $surface;
    color: $secondary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary 20%;
}

Log {
    background: $surface;
    color: $text;
    border: none;
    height: 1fr;
    scrollbar-size: 0 0;
}

#progress-area {
    height: 1;
    content-align: center middle;
    margin-top: 1;
}

.status-checking { color: $secondary; }
.status-success { color: $accent; text-style: bold; }
.status-failed { color: $text 50%; }
.status-error { color: $error; }
